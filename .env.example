# Exemple de configuration — copier en `.env` puis ajuster.
# Le `.env` réel est ignoré par git.

# --- Base de données ---
# Locale (docker-compose) : postgresql+psycopg://postgres:postgres@localhost:5432/oid
# Production (Supabase) :  postgresql+psycopg://postgres.<ref-projet>:<mot-de-passe>@db.<ref-projet>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/oid

# --- Authentification JWT (Tranche 1) ---
# Générer un secret fort : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Limite de débit API publique (slowapi) ---
RATE_LIMIT=5/minute

# --- Divers ---
DEBUG=false
BASE_URL=http://localhost:8000
